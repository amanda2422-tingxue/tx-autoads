# Database Configuration
# 复制此文件为 .env 并填入实际值

# PostgreSQL 连接字符串
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:autoads123@localhost:5432/autoads?schema=public"

# 开发环境数据库（可选）
# DATABASE_URL_DEV="postgresql://postgres:autoads123@localhost:5432/autoads_dev?schema=public"

# 测试环境数据库（可选）
# DATABASE_URL_TEST="postgresql://postgres:autoads123@localhost:5432/autoads_test?schema=public"
