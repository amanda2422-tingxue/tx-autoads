{
  "name": "autoads-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Facebook 广告自动化平台 - 基于 Smartly.io 架构参考",
  "scripts": {
    "start": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @autoads/api db:migrate",
    "db:generate": "pnpm --filter @autoads/api db:generate",
    "db:studio": "pnpm --filter @autoads/api db:studio"
  },
  "devDependencies": {
    "turbo": "^1.11.0"
  },
  "packageManager": "pnpm@8.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
